# Copiá este archivo a .env y completá los valores.
# .env está en .gitignore: no se versiona ni se sube a GitHub.

# Clave de la API de generación. Se usa SOLO en backend/api.py::generar
OPENAI_API_KEY=

# Modelo de generación (opcional)
RAG_MODELO_GEN=gpt-4o-mini

# Ruta al índice y al modelo de embeddings (opcional; hay valores por defecto)
# RAG_INDICE=indice
# RAG_MODELO_EMB=modelos/bge-m3
