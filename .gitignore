# Corpus de PDFs (8,6 GiB). Se baja del Drive con ingesta/download_portal_rclone.sh
data/

# Wheels para instalación offline en Clementina (58 MB, regenerables con
# pipeline/01_bajar_wheels.sh)
pipeline/wheels-py*/

# Salidas del pipeline
resultados_extractor/
canonicos/
*_canonico.yaml
docus_error.txt
docus_escaneos.txt
errores_extraccion.log

# Logs de SLURM
*.out
*.err
slurm-*.out

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# macOS
.DS_Store

# Frontend
node_modules/
dist/

# Pesos de modelos (2,3 GB, se bajan con pipeline/03_preparar_embeddings.sh)
modelos/
indice/
resultados/

# Claves y configuración local: NUNCA se versiona
.env

frontend/.env.local

# --- Datos, nunca al repositorio ---
# Conversaciones de los usuarios: correos, nombres y lo que consultaron. El repositorio es
# público, y una vez que algo entra al historial de git no se saca borrando el archivo.
datos/

# Catálogo y descargas: son salida de la recolección, se regeneran con el pipeline y pesan.
# Además el catálogo se escribe mientras corre, así que versionarlo captura estados a medio
# hacer.
scrapers/metadatos*.csv
scrapers/meta_*.csv
scrapers/catalogo_*.csv
scrapers/Descargas/
data/
indice/
scrapers/traza.jsonl
datos/chatdigesto.sqlite
/datos
scrapers/traza.jsonl
scrapers/traza.jsonl

# Instalaciones: en el repo va solo la configuración; los datos de cada instancia, no.
instalaciones/*/.env
instalaciones/*/datos/
instalaciones/*/data/
instalaciones/*/indice/
instalaciones/*/logs/
datos/chatdigesto.sqlite

# Revisión de seguridad: describe debilidades no corregidas, no se publica.
seguridad/

# Índices alternativos y respaldos. Es el mismo contenido que indice/ y pesa lo mismo
# ---el de la última comparación, 1,6 GB---, y se regenera con el pipeline. La
# reconstrucción total deja además el anterior como indice.previo-<sello> al lado.
indice-*/
indice.previo-*/

# El catálogo y la traza de cada instalación son datos de esa instancia, con el mismo
# criterio que los del repo: salida de la recolección, se regeneran desde el panel y pesan
# (16 MB el de UNSL). El código adaptado de cada instancia sí se versiona.
instalaciones/*/scrapers/metadatos*.csv
instalaciones/*/scrapers/meta_*.csv
instalaciones/*/scrapers/traza.jsonl

# Copias .previo: las dejan los scripts del pipeline al reemplazar un archivo, y son la
# versión anterior de un dato o de un fuente. Sirven en el disco, no en el historial.
*.previo

# Ningún CSV bajo scrapers/ es código: todos son catálogos, listados intermedios o mapeos
# de la recolección. Se regeneran con la operación 1 del panel.
scrapers/**/*.csv

# Cuántos documentos declara cada carpeta del portal. Es memoria de la recolección de esta
# instancia, del mismo tipo que el catálogo: se aprende corriendo, no se versiona.
scrapers/totales.json
instalaciones/*/scrapers/totales.json
