[Unit]
Description=ChatDigesto UNLu (RAG del digesto)
After=network.target

[Service]
User=administrador
WorkingDirectory=/home/administrador/rag-unlu
Environment=OMP_NUM_THREADS=4
# El modelo ya está en la caché local (copiada por rsync); sin estas variables
# sentence-transformers consulta Hugging Face al arrancar y se cuelga sin Internet.
Environment=HF_HOME=/home/administrador/rag-unlu/.cache/huggingface
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
# La UNLu sale a Internet por proxy institucional (OpenAI, Google, portal).
# Este es el respaldo de despliegue; el panel de Generación puede pisarlo.
Environment=HTTPS_PROXY=http://proxy.unlu.edu.ar:8080
Environment=HTTP_PROXY=http://proxy.unlu.edu.ar:8080
Environment=NO_PROXY=localhost,127.0.0.1
ExecStart=/home/administrador/rag-unlu/.venv/bin/python -m uvicorn backend.api:app --host 127.0.0.1 --port 8000 --log-level warning
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
