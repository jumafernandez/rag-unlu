#!/bin/bash
# Despliegue de ChatDigesto en la VM. Se instala en /usr/local/sbin/desplegar-rag,
# propiedad de root y sin permiso de escritura para nadie más, y se habilita en
# sudoers para la cuenta de mantenimiento SIN contraseña.
#
# Por qué un script y no `sudo rsync`: un permiso para rsync es un permiso para
# escribir cualquier archivo del sistema como root, porque los argumentos los elige
# quien lo invoca. Acá no hay argumentos: los orígenes y los destinos están fijos,
# y lo único que se puede hacer con este permiso es desplegar esta aplicación.
#
# El alcance real de este permiso: quien pueda escribir en la carpeta de preparación
# consigue ejecutar código como `ragunlu`, el usuario del servicio. No como root.
set -euo pipefail

ORIGEN=/home/administrador/deploy-pendiente
DESTINO=/opt/rag-unlu
SERVICIO=rag-unlu

[ -d "$ORIGEN" ] || { echo "no hay nada preparado en $ORIGEN"; exit 1; }

# Estas partes son código puro: se reemplazan enteras, con --delete, para que un archivo
# borrado en el repo desaparezca también acá. El resto de la aplicación ---índice, datos,
# entorno virtual, .env--- no se toca nunca desde acá: son estado, no código.
for parte in backend frontend/dist docs; do
    if [ -d "$ORIGEN/$parte" ]; then
        install -d -o ragunlu -g ragunlu "$DESTINO/$(dirname "$parte")"
        rsync -a --delete --chown=ragunlu:ragunlu "$ORIGEN/$parte/" "$DESTINO/$parte/"
        echo "desplegado: $parte"
    fi
done

# El recolector y el pipeline son el código que el panel ejecuta como operaciones, así que
# tienen que viajar en el despliegue: si no, el panel sigue corriendo la versión vieja
# mientras el backend ya es nuevo.
#
# Van con otras reglas que las de arriba, y el motivo es que estas dos carpetas no son
# solo código: son también donde la VM ESCRIBE. El catálogo y la traza se generan acá, con
# las operaciones del panel, y esa copia es la buena; la del repo es una copia vieja de
# desarrollo. Por eso, en vez de excluir los datos conocidos ---una lista negra que hay
# que acordarse de ampliar cada vez que aparece un archivo nuevo--- se listan los tipos
# que SÍ viajan. Lo que no es código no llega, aunque nadie lo haya previsto.
#
# Y sin --delete: borrar lo que no vino en el despliegue sería borrar exactamente esos
# datos, y rehacer la recolección completa del portal.
for parte in scrapers pipeline; do
    if [ -d "$ORIGEN/$parte" ]; then
        install -d -o ragunlu -g ragunlu "$DESTINO/$parte"
        rsync -a --chown=ragunlu:ragunlu \
              --include='*/' --include='*.py' --include='*.slurm' --exclude='*' \
              "$ORIGEN/$parte/" "$DESTINO/$parte/"
        echo "desplegado: $parte (solo código; el catálogo de la VM no se toca)"
    fi
done

# Las configuraciones de systemd y nginx quedan afuera a propósito: cambian el
# entorno de ejecución del servicio y del servidor web, así que siguen requiriendo
# una decisión humana y no viajan en un despliegue de código.

systemctl restart "$SERVICIO"
echo "servicio reiniciado; tarda alrededor de dos minutos en cargar índice y modelo"
